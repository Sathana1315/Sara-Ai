# SARA Environment Configuration Template
# Copy to .env and fill in your values
# DO NOT commit .env to Git

# ============================================================
# Backend API
# ============================================================
PORT=3001
NODE_ENV=development

# ============================================================
# Supabase Configuration
# Project URL: https://app.supabase.com → Settings → API
# ============================================================
SUPABASE_URL=https://xloherpfgrrkgegdxipx.supabase.co

# Publishable Key (safe for browser/extension client code, governs by RLS)
# Found in: Supabase Dashboard → Settings → API → Project API keys → publishable
SUPABASE_PUBLISHABLE_KEY=sb_publishable_UVoJ0YHaACT9mIKf0ABxtw_4PNNeQSA

# Service Role Key (SERVER ONLY — NEVER commit, NEVER expose to browser/extension)
# Found in: Supabase Dashboard → Settings → API → Project API keys → service_role
# Used only in apps/backend for privileged server-side operations
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ============================================================
# Dashboard Vite env vars (prefixed with VITE_)
# ============================================================
VITE_SUPABASE_URL=https://xloherpfgrrkgegdxipx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_UVoJ0YHaACT9mIKf0ABxtw_4PNNeQSA
VITE_BACKEND_URL=http://localhost:3001

# ============================================================
# Google OAuth Configuration
# REQUIRES USER ACTION — see Phase 2 walkthrough for instructions
# ============================================================
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs
# Client type: Web Application (for dashboard)
# Authorized Redirect URIs: http://localhost:3000 (dev), your production URL
#
# After creating credentials, configure in:
# Supabase Dashboard → Authentication → Providers → Google
GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id_here
# GOOGLE_OAUTH_CLIENT_SECRET is configured only in Supabase Dashboard — NOT stored here

# ============================================================
# Chrome Extension Configuration
# NOTE: Extension ID is only known after loading in Chrome
# chrome-extension://<YOUR_EXTENSION_ID>/
# ============================================================
# EXTENSION_ID=your_extension_id_here  # For reference only
